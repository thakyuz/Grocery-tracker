# Copy to .env (or export in your shell / crontab). Only the parts you use are needed.

# Where the SQLite database and digest HTML files live
GROCERY_DB=data/grocery.db
GROCERY_OUT_DIR=out

# Kroger developer API (Fred Meyer + QFC) - register at https://developer.kroger.com
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# store:locationId pairs; find IDs with `grocery kroger-locations --zip 98101`
KROGER_LOCATIONS=fred_meyer:70100000,qfc:70500000
# Extra search terms beyond your frequent products (comma-separated)
KROGER_EXTRA_TERMS=

# Weekly ad sources (URL or local path to a PDF, image, HTML or text file)
SAFEWAY_AD_SOURCE=
METMARKET_AD_SOURCE=

# Claude API, used for ad and receipt extraction and match tie-breaks
ANTHROPIC_API_KEY=
GROCERY_LLM_MODEL=claude-opus-5-5

# Gmail: IMAP to fetch receipts, SMTP to send the digest. Use a Gmail app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=
